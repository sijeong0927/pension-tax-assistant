PROJECT_NAME=Pension Tax Assistant

# ==========================================
# OpenAI API Settings
# ==========================================
# 이 파일에는 실제 키를 적지 않습니다. 
# .env.local로 복사한 뒤 .env.local에만 입력하세요.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# ==========================================
# Database & Knowledge Base (ChromaDB / RAG)
# ==========================================
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=pension_tax_faq
KNOWLEDGE_BASE_PATH=app/data/tax_faq.json

RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_INDEX_DOCUMENTS=100

# ==========================================
# Supabase Settings (New)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# Auth JWT Secret
# ==========================================
SECRET_KEY="your_super_secret_jwt_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=43200