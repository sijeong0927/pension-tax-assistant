PROJECT_NAME=Pension Tax Assistant

# 이 파일에는 실제 키를 적지 않습니다. .env로 복사한 뒤 .env에만 입력하세요.
# OpenAI API는 비용이 발생하므로 자동 반복·무제한 호출·실키 기반 부하 테스트를
# 절대 금지합니다. 지식베이스 적재는 원문이 바뀐 경우에만 수동 실행합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=pension_tax_faq
KNOWLEDGE_BASE_PATH=app/data/tax_faq.json

RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_INDEX_DOCUMENTS=100
