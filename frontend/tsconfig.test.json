{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".test-build",
    "target": "ES2022",
    "tsBuildInfoFile": ".test-build/tsconfig.tsbuildinfo"
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
